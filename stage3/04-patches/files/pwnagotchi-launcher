#!/usr/bin/env bash
source /usr/bin/pwnlib

# we need to decrypt something
if is_crypted_mode; then
  while ! is_decrypted; do
    echo "Waiting for decryption..."
    sleep 1
  done
fi

# Mode (Manual/Agent/Engine) is decided at runtime by the agent itself from
# /etc/pwnagotchi/.mode then config main.mode (see pwnagotchi/modes.py) — no
# more usb0 guessing. Just launch; the agent picks up where it left off.
/opt/.pwn/bin/pwnagotchi
